							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Комментарий опубликован (200)\", function() {",
									"    pm.response.to.have.status(200);",
									"    const jsonData = pm.response.json();",
									"    pm.expect(jsonData.status).to.eql(\"PUBLISHED\");",

		{
			"name": "2. Тесты комментариев",
			"item": [
				{
					"name": "Создать валидный комментарий",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Комментарий создан (201)\", function() {",
									"    pm.response.to.have.status(201);",
									"    const jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.have.property('id');",
									"    pm.collectionVariables.set(\"commentId1\", jsonData.id);",
									"    pm.expect(jsonData.status).to.eql(\"PENDING\");",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"text\": \"Это тестовый комментарий\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/users/{{userId}}/comments?eventId={{eventId}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"users",
								"{{userId}}",
								"comments"
							],
							"query": [
								{
									"key": "eventId",
									"value": "{{eventId}}"
								}
							]
						}
					},
					"response": []
				},
				{
					"name": "Попытка создать пустой комментарий",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Ошибка валидации (400)\", function() {",
									"    pm.response.to.have.status(400);",
									"    const jsonData = pm.response.json();",
									"    pm.expect(jsonData.status).to.eql(\"BAD_REQUEST\");",
									"    pm.expect(jsonData.errors).to.include(\"text: Текст комментария не может быть пустым\");",
									"    pm.expect(jsonData.errors).to.include(\"text: Комментарий должен содержать от 1 до 2000 символов\");",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"text\": \"\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/users/{{userId}}/comments?eventId={{eventId}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"users",
								"{{userId}}",
								"comments"
							],
							"query": [
								{
									"key": "eventId",
									"value": "{{eventId}}"
								}
							]
						}
					},
					"response": []
				},
